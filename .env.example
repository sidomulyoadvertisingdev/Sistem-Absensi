APP_NAME=Sistem-Absensi
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

PLATFORM_API_URL=http://localhost:8080/api/v1
PLATFORM_API_KEY=absensi_live_placeholder
APP_PLATFORM_CODE=absensi
PLATFORM_CACHE_TTL=300

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absensi
DB_USERNAME=root
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pakai Redis untuk cache / session / queue biar ringan.
# Butuh: ekstensi PHP redis (phpredis) + redis-server jalan.
# Fallback aman kalau tidak ada Redis: ganti ketiganya ke "database".
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Integrasi ERP (ERPSIDOMULYO) — fitur produksi / broadcast job helper
ERP_BASE_URL=https://dashboard.sidomulyoproject.com/api
ERP_PARTNER_API_KEY=
ERP_PARTNER_API_SECRET=
ERP_API_TIMEOUT=15
PRODUCTION_JOB_SYNC_ENABLED=true

# Google Maps (peta pemilih lokasi absensi di panel admin) - opsional, fallback ke OpenStreetMap bila kosong
GOOGLE_MAPS_API_KEY=

# Deteksi "badan penuh" absensi kios (MediaPipe Pose).
# Server perlu: python3 + `pip install -r scripts/pose/requirements.txt`.
# Bila kosong / tidak tersedia -> aplikasi otomatis pakai foto manual.
POSE_DETECTION_ENABLED=true
POSE_PYTHON_BIN=python3
POSE_TIMEOUT=15

# Realtime chat (Laravel Reverb). WAJIB agar chat realtime jalan.
# Reverb harus di-reverse-proxy: wss://<REVERB_HOST>/app  ->  server reverb (port internal 8080).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="admin.sidomulyoproject.com"
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
